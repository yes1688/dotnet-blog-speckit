# 資料庫密碼
# 注意: 生產環境請使用強密碼
DB_PASSWORD=your_secure_password_here

# Google OAuth 2.0 憑證
# 需先在 Google Cloud Console 建立 OAuth 2.0 客戶端 ID
# 詳細設定步驟請參考 specs/001-personal-blog/quickstart.md

# 客戶端 ID (格式: xxxxx.apps.googleusercontent.com)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# 客戶端密鑰
GOOGLE_CLIENT_SECRET=your_client_secret

# 管理員 email 清單
# 格式: 逗號分隔,不要有空格
# 範例: admin@example.com,user@example.com,another@example.com
ADMIN_EMAILS=admin@example.com

# 使用說明:
# 1. 複製此檔案為 .env: cp .env.example .env
# 2. 編輯 .env 填入實際的值
# 3. 確保 .env 已加入 .gitignore (不要提交到版本控制)
# 4. 啟動容器: podman-compose up -d
