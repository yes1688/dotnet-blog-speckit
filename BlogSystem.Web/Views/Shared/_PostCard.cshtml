@model BlogSystem.Web.ViewModels.PostListViewModel

<div class="col-md-12 mb-4">
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">
                <a href="/@Model.Slug" class="text-decoration-none text-dark">@Model.Title</a>
            </h5>
            <p class="card-text text-muted">@Model.Summary</p>

            <!-- 分類與標籤 -->
            <div class="mb-2">
                @if (Model.CategoryName != null)
                {
                    <span class="badge bg-primary me-2">
                        <i class="bi bi-folder"></i> @Model.CategoryName
                    </span>
                }
                @if (Model.Tags != null && Model.Tags.Any())
                {
                    @foreach (var tag in Model.Tags)
                    {
                        <span class="badge bg-secondary me-1">
                            <i class="bi bi-tag"></i> @tag
                        </span>
                    }
                }
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <div class="text-muted small">
                    <span>@Model.PublishedAt.ToString("yyyy-MM-dd")</span>
                    <span class="ms-2">· @Model.ViewCount 次瀏覽</span>
                </div>
            </div>
        </div>
    </div>
</div>
