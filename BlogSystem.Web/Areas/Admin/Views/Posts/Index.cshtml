@model IEnumerable<BlogSystem.Web.Areas.Admin.ViewModels.PostListViewModel>
@{
    ViewData["Title"] = "文章管理";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <!-- 頁面標題和操作按鈕 -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h2 mb-0">@ViewData["Title"]</h1>
                <a href="@Url.Action("Create")" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>新增文章
                </a>
            </div>
        </div>
    </div>

    <!-- 顯示成功/錯誤訊息 -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 文章列表 -->
    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>標題</th>
                                <th>狀態</th>
                                <th>分類</th>
                                <th class="text-center">瀏覽次數</th>
                                <th>建立時間</th>
                                <th>更新時間</th>
                                <th class="text-end">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var post in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@post.Title</strong>
                                        @if (!string.IsNullOrEmpty(post.Summary))
                                        {
                                            <br />
                                            <small class="text-muted">@(post.Summary.Length > 50 ? post.Summary.Substring(0, 50) + "..." : post.Summary)</small>
                                        }
                                    </td>
                                    <td>
                                        @if (post.Status == BlogSystem.Core.Enums.PostStatus.Published)
                                        {
                                            <span class="badge bg-success">已發布</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">草稿</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(post.CategoryName))
                                        {
                                            <span class="badge bg-info text-dark">@post.CategoryName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">無分類</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark">@post.ViewCount</span>
                                    </td>
                                    <td>
                                        <small>@post.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                                    </td>
                                    <td>
                                        <small>@post.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group" role="group">
                                            <!-- 編輯按鈕 -->
                                            <a href="@Url.Action("Edit", new { id = post.Id })"
                                               class="btn btn-sm btn-outline-primary"
                                               title="編輯">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <!-- 發布/取消發布按鈕 -->
                                            @if (post.Status == BlogSystem.Core.Enums.PostStatus.Published)
                                            {
                                                <form method="post"
                                                      action="@Url.Action("Unpublish", new { id = post.Id })"
                                                      class="d-inline unpublish-form">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-warning"
                                                            title="取消發布"
                                                            data-post-title="@post.Title">
                                                        <i class="bi bi-eye-slash"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form method="post"
                                                      action="@Url.Action("Publish", new { id = post.Id })"
                                                      class="d-inline publish-form">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success"
                                                            title="發布"
                                                            data-post-title="@post.Title">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                </form>
                                            }

                                            <!-- 刪除按鈕 -->
                                            <form method="post"
                                                  action="@Url.Action("Delete", new { id = post.Id })"
                                                  class="d-inline delete-form">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="刪除"
                                                        data-post-title="@post.Title">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- 空狀態 -->
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-file-earmark-text text-muted" style="font-size: 4rem;"></i>
                <h4 class="mt-3 text-muted">尚無文章</h4>
                <p class="text-muted mb-4">立即新增第一篇文章吧！</p>
                <a href="@Url.Action("Create")" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>新增文章
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // 刪除確認對話框
        document.querySelectorAll('.delete-form').forEach(form => {
            form.addEventListener('submit', function(e) {
                const postTitle = this.querySelector('button').dataset.postTitle;
                if (!confirm(`確定要刪除文章「${postTitle}」嗎？此操作無法復原。`)) {
                    e.preventDefault();
                }
            });
        });

        // 發布確認對話框
        document.querySelectorAll('.publish-form').forEach(form => {
            form.addEventListener('submit', function(e) {
                const postTitle = this.querySelector('button').dataset.postTitle;
                if (!confirm(`確定要發布文章「${postTitle}」嗎？`)) {
                    e.preventDefault();
                }
            });
        });

        // 取消發布確認對話框
        document.querySelectorAll('.unpublish-form').forEach(form => {
            form.addEventListener('submit', function(e) {
                const postTitle = this.querySelector('button').dataset.postTitle;
                if (!confirm(`確定要取消發布文章「${postTitle}」嗎？`)) {
                    e.preventDefault();
                }
            });
        });
    </script>
}
